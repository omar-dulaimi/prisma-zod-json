{
  "name": "prisma-next-zod-json",
  "version": "0.1.0",
  "description": "Typed JSON columns for Prisma Next, described and enforced by zod. Implements the zod/json@1 codec.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "peerDependencies": {
    "@prisma-next/contract": "^0.16.0",
    "@prisma-next/contract-authoring": "^0.16.0",
    "@prisma-next/family-sql": "^0.16.0",
    "@prisma-next/framework-components": "^0.16.0",
    "@prisma-next/sql-relational-core": "^0.16.0",
    "@prisma-next/sql-runtime": "^0.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@prisma-next/contract": "0.16.0",
    "@prisma-next/contract-authoring": "0.16.0",
    "@prisma-next/family-sql": "0.16.0",
    "@prisma-next/framework-components": "0.16.0",
    "@prisma-next/sql-contract": "0.16.0",
    "@prisma-next/sql-relational-core": "0.16.0",
    "@prisma-next/sql-runtime": "0.16.0",
    "@types/node": "22.19.0",
    "tsdown": "0.22.8",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./codec-types": {
      "types": "./dist/codec-types.d.mts",
      "default": "./dist/codec-types.mjs"
    },
    "./codecs": {
      "types": "./dist/codecs.d.mts",
      "default": "./dist/codecs.mjs"
    },
    "./column-types": {
      "types": "./dist/column-types.d.mts",
      "default": "./dist/column-types.mjs"
    },
    "./control": {
      "types": "./dist/control.d.mts",
      "default": "./dist/control.mjs"
    },
    "./pack": {
      "types": "./dist/pack.d.mts",
      "default": "./dist/pack.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "default": "./dist/runtime.mjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "tsdown"
  },
  "author": "Omar Dulaimi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omar-dulaimi/prisma-next-zod-json.git"
  },
  "homepage": "https://github.com/omar-dulaimi/prisma-next-zod-json#readme",
  "bugs": {
    "url": "https://github.com/omar-dulaimi/prisma-next-zod-json/issues"
  },
  "keywords": [
    "prisma",
    "prisma-next",
    "zod",
    "json-schema",
    "codec",
    "jsonb",
    "validation",
    "postgres",
    "extension"
  ]
}
